# Hub defaults to loopback ComfyUI and a loopback HTTP bind.
DATA_DIR=./data
HUB_HOST=127.0.0.1
HUB_PORT=3000
MAX_UPLOAD_BYTES=52428800
MAX_ASSET_BYTES=52428800
MAX_OUTPUT_BYTES=2147483648
MAX_CONCURRENT_ARCHIVES=2
COMFY_TRANSFER_IDLE_TIMEOUT_MS=120000

# ComfyUI upstream (hostnames and IP addresses are accepted):
# COMFY_BASE_URL=http://192.168.0.2:8188

# To make the hub reachable by other agents on the LAN, set:
# HUB_HOST=0.0.0.0
# The hub has no authentication or Host/Origin checks; do not expose it to an untrusted network.
